function doGet(e) {
  try {
    e = e || { parameter: {} };
    var action = String((e.parameter && e.parameter.action) || "");
    if (action === "slots") {
      return jsonOutput_({
        ok: true,
        date: String(e.parameter.date || ""),
        booked: getBookedTimes_(String(e.parameter.date || "")),
      });
    }
    return ContentService.createTextOutput(
      "JOYFIT24 Kyodo Machine Lecture API"
    );
  } catch (error) {
    return jsonOutput_({ ok: false, error: String(error) });
  }
}

