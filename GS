function getSheet_() {
  var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  var sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) {
    throw new Error(
      'シート「' + SHEET_NAME + '」が見つかりません。スプレッドシートのタブ名を確認してください。'
    );
  }
  return sheet;
}

/** 指定日の予約済み開始時刻一覧（HH:MM） */
function getBookedTimes_(dateStr) {
  var date = normalizeDate_(dateStr);
  if (!date) return [];
  return getBookedTimesFromSheet_(getSheet_(), date);
}

function getBookedTimesFromSheet_(sheet, date) {
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];

  // A:timestamp B:name C:age D:email E:machines F:date G:time
  var values = sheet.getRange(2, 6, lastRow, 7).getValues();
  var booked = [];
  var seen = {};

  for (var i = 0; i < values.length; i++) {
    var rowDate = normalizeDate_(values[i][0]);
    var rowTime = normalizeTime_(values[i][1]);
    if (!rowDate || !rowTime) continue;
    if (rowDate !== date) continue;
    if (seen[rowTime]) continue;
    seen[rowTime] = true;
    booked.push(rowTime);
  }
  return booked;
}

function normalizeDate_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) {
    return Utilities.formatDate(value, "Asia/Tokyo", "yyyy-MM-dd");
  }
  var s = String(value == null ? "" : value).trim();
  if (!s) return "";
  // yyyy-MM-dd / yyyy/MM/dd
  var m = s.match(/^(\d{4})[\/\-.](\d{1,2})[\/\-.](\d{1,2})/);
  if (m) {
    return (
      m[1] +
      "-" +
      ("0" + m[2]).slice(-2) +
      "-" +
      ("0" + m[3]).slice(-2)
    );
  }
  return s;
}

function normalizeTime_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) {
    return Utilities.formatDate(value, "Asia/Tokyo", "HH:mm");
  }
  var s = String(value == null ? "" : value).trim();
  var m = s.match(/(\d{1,2})[:：](\d{2})/);
  if (!m) return s;
  return ("0" + Number(m[1])).slice(-2) + ":" + m[2];
}

function jsonOutput_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(
    ContentService.MimeType.JSON
  );
}

function escapeHtml_(str) {
  return String(str)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}
